        "raw_score_weighted": 4.8156,
        "final_score_argmax": 6,
        "final_score": 4.8156,
        "digit_prob_mass": 0.7302
      },
      "28": {
        "content": "They believe they should always show respect to their parents and to older people. It is important to them to be obedient.",
