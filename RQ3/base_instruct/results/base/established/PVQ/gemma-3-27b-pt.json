        "raw_score_argmax": 6,
        "raw_score_weighted": 4.822,
        "final_score_argmax": 6,
        "final_score": 4.822,
        "digit_prob_mass": 0.7603
      },
      "30": {
        "content": "They like surprises. It is important to them to have an exciting life.",
